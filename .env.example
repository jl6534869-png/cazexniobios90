# Copy the pooled PostgreSQL connection URI from Neon Free (keep TLS parameters).
DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAIRING_CODE=REPLACE_WITH_RANDOM_CODE_AT_LEAST_24_CHARACTERS
# Generate once with npm run vapid. Preserve both keys when upgrading.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-existing-email@example.com
# Optional on Vercel: stable production origin is obtained from system variables.
# For local development, uncomment this line:
# APP_ORIGIN=http://localhost:3000
# Optional exact HTTPS origins for links opened from notification details.
DESTINATION_ORIGINS=
# DIRECT_URL is optional for a non-Neon provider. Neon direct migration URL is derived automatically.
