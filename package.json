{
  "name": "blockchain",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run compile:runtime && node --test .runtime/tests/*.test.js && node --test tests/*.test.mjs",
    "compile:runtime": "node scripts/clean-runtime.mjs && tsc -p tsconfig.runtime.json",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "vapid": "web-push generate-vapid-keys",
    "assets": "node scripts/assets.mjs",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
