{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".runtime",
    "rootDir": ".",
    "incremental": false,
    "isolatedModules": true,
    "plugins": []
  },
  "include": ["tests/**/*.ts"],
  "exclude": ["node_modules", ".next", ".runtime"]
}
